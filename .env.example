# Copy to `.env.local` and fill in values, then restart `npm run dev`.

# Postgres (Neon or local)
POSTGRES_URL=

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=

# OpenAI (chat + title generation)
OPENAI_API_KEY=

# Optional: default chat model (see lib/ai/models.ts)
# CHAT_MODEL=openai/gpt-4.1-mini

# Sarvam speech-to-text (voice composer)
SARVAM_API_KEY=

# Optional: IP rate limiting in production
# REDIS_URL=

# Twilio WhatsApp sandbox. Account SID and auth token stay server-side.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=+14155238886
# TWILIO_SANDBOX_JOIN_CODE=join your-sandbox-code
# Public site origin used in the reminder link
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Bearer secret for GET /api/cron/whatsapp-reminders.
# An outside scheduler (for example cron-job.org) sends it every 15 minutes.
# Generate with: openssl rand -base64 32
# CRON_SECRET=
