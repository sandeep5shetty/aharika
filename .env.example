# ---------------------------------------------------------------------------
# OpenAI setup (local development)
# ---------------------------------------------------------------------------
# 1. Copy this file to `.env.local` in the project root (same folder as package.json).
# 2. Paste your OpenAI API key below (starts with sk-proj- or sk-).
# 3. Restart the dev server: stop `npm run dev`, then run it again.
#
# Never commit `.env.local` or paste keys into git — it stays on your machine only.
# The chat route reads the key server-side in `app/api/chat/route.ts`.
# ---------------------------------------------------------------------------

OPENAI_API_KEY=

# Optional: override the default model (default without this line: gpt-5.4-mini).
# Examples:
# CHAT_MODEL=gpt-4o-mini
# CHAT_MODEL=gpt-4o

# Alternative (same as OPENAI_API_KEY for standard OpenAI keys):
# AI_API_KEY=sk-proj-...
